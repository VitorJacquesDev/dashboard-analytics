generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  role            Role             @default(VIEWER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  shares          DashboardShare[]
  dashboards      Dashboard[]
  layouts         Layout[]
  schedules       Schedule[]
  profileSettings ProfileSettings?

  @@index([email])
  @@map("users")
}

model ProfileSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  avatarUrl           String?
  bio                 String?
  language            String   @default("pt-BR")
  timezone            String   @default("America/Sao_Paulo")
  theme               Theme    @default(LIGHT)
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(false)
  weeklyReportEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_settings")
}

model Dashboard {
  id                String             @id @default(uuid())
  title             String
  description       String?
  userId            String
  isPublic          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  shares            DashboardShare[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  layouts           Layout[]
  widgets           Widget[]
  schedules         Schedule[]
  salesOrders       SalesOrder[]
  marketingLeads    MarketingLead[]
  operationsTickets OperationsTicket[]

  @@index([userId])
  @@index([createdAt])
  @@map("dashboards")
}

model SalesOrder {
  id           String    @id @default(uuid())
  dashboardId  String
  orderNumber  String
  customerName String
  region       String
  channel      String
  status       String
  orderDate    DateTime
  totalAmount  Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([orderDate])
  @@index([status])
  @@index([region])
  @@index([channel])
  @@map("sales_orders")
}

model MarketingLead {
  id              String    @id @default(uuid())
  dashboardId     String
  leadName        String
  channel         String
  campaign        String
  stage           String
  isConverted     Boolean   @default(false)
  estimatedValue  Float?
  acquisitionCost Float?
  capturedAt      DateTime
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dashboard       Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([capturedAt])
  @@index([channel])
  @@index([campaign])
  @@index([stage])
  @@index([isConverted])
  @@map("marketing_leads")
}

model OperationsTicket {
  id                String    @id @default(uuid())
  dashboardId       String
  title             String
  team              String
  priority          String
  status            String
  openedAt          DateTime
  resolvedAt        DateTime?
  resolutionMinutes Int?
  slaBreached       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  dashboard         Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([openedAt])
  @@index([status])
  @@index([priority])
  @@index([slaBreached])
  @@map("operations_tickets")
}

model Widget {
  id          String     @id @default(uuid())
  dashboardId String
  type        WidgetType
  title       String
  config      Json
  dataSource  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("widgets")
}

model Layout {
  id          String    @id @default(uuid())
  userId      String
  dashboardId String
  layout      Json
  theme       Theme     @default(LIGHT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboardId])
  @@index([userId])
  @@index([dashboardId])
  @@map("layouts")
}

model DashboardShare {
  id          String     @id @default(uuid())
  dashboardId String
  userId      String
  permission  Permission @default(VIEW)
  createdAt   DateTime   @default(now())
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([dashboardId])
  @@index([userId])
  @@map("dashboard_shares")
}

model Schedule {
  id          String         @id @default(uuid())
  userId      String
  name        String
  cronExpr    String
  dashboardId String
  format      ExportFormat[]
  recipients  String[]
  isActive    Boolean        @default(true)
  lastRun     DateTime?
  nextRun     DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard   Dashboard      @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dashboardId])
  @@index([isActive])
  @@index([nextRun])
  @@map("schedules")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum WidgetType {
  LINE_CHART
  BAR_CHART
  PIE_CHART
  AREA_CHART
  HEATMAP
  SCATTER_CHART
  TABLE
  METRIC
}

enum Theme {
  LIGHT
  DARK
}

enum Permission {
  VIEW
  EDIT
  ADMIN
}

enum ExportFormat {
  PDF
  CSV
  XLSX
}
